# Empêche l'exécution de scripts dans le dossier des images blog (Apache)
<FilesMatch "\.(php|phtml|php3|php4|php5|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
